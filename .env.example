# ============================================================
# TALLER DE INTEGRACIÓN II - VARIABLES DE ENTORNO
# ============================================================
# Copiar este archivo como .env en la raíz del proyecto:
#   cp .env.example .env
#
# IMPORTANTE: No subir el archivo .env al repositorio.
# ============================================================

# ------------------------------------------------------------
# VERSIONES DEL ENTORNO DE DESARROLLO (Referencia para el equipo)
# ------------------------------------------------------------
# Node.js        : v24.15.0
# npm            : 11.12.1
# pnpm           : 12.4.2   (recomendado como gestor de paquetes)
# Git            : 2.55.0
# Docker         : 29.8.0
# Docker Compose : 5.5.1
# WSL            : 2.7.14
# NestJS CLI     : 12.0.1
# ------------------------------------------------------------

# ------------------------------------------------------------
# VERSIONES DE DEPENDENCIAS DEL PROYECTO (npm packages)
# ------------------------------------------------------------
# NestJS Core    : 12.0.3
# Prisma ORM     : 6.19.3
# Prisma Client  : 6.19.3
# Vite           : 8.3.0
# React          : 19.3.0
# Tailwind CSS   : 4.3.3
# TypeScript     : 7.0.2
# ------------------------------------------------------------
# ========================
# MS-AUTH (Microservicio de Autenticación)
# ========================
AUTH_PORT=3001
JWT_SECRET=super_secret_key_change_me
JWT_EXPIRATION=24h

# ========================
# MS-INCIDENCIAS (Microservicio de Incidencias)
# ========================
INCIDENCIAS_PORT=3002
NOTIFICACIONES_PORT=3004

# ========================
# API GATEWAY
# ========================
GATEWAY_PORT=3000

# ========================
# FRONTEND WEB (Vite + React)
# ========================
VITE_API_URL=http://localhost:${GATEWAY_PORT}/api
VITE_APP_NAME=Taller Integración II

# ========================
# CLOUDINARY (Almacenamiento multimedia)
# ========================
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ========================
# NODEMAILER (Envío de correos)
# ========================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_correo@gmail.com
MAIL_PASSWORD=tu_app_password
MAIL_FROM="Taller Integración II <noreply@tallerintegracion.cl>"

# ==============================================================================
# FEATURE FLAGS & EMERGENCY KILL SWITCH (TAL-4 / TAL-210)
# ==============================================================================
# Habilita el modo de suspensión rápida de operaciones mutantes (POST, PUT, PATCH, DELETE)
# en el módulo de incidencias y órdenes de trabajo, manteniendo lecturas (GET) activas.
# Valores permitidos: true | false (o 1 | 0)
# Arranque seguro por defecto: false
KILL_SWITCH_INCIDENCIAS_ENABLED=false

# Mensaje oficial expuesto al cliente (HTTP 503) y al frontend (TAL-188) durante la suspensión
KILL_SWITCH_MOTIVO="El módulo de incidencias se encuentra temporalmente suspendido por mantenimiento crítico de emergencia."

# Clave administrativa de emergencia (cabecera x-admin-key) para conmutar el Kill Switch
# en caliente vía POST /api/v1/admin/kill-switch sin reiniciar contenedores
ADMIN_API_KEY=cambiar_por_secreto_seguro_en_produccion
KILL_SWITCH_ADMIN_SECRET=cambiar_por_secreto_seguro_en_produccion