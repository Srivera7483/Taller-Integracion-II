# ============================================================
# TALLER DE INTEGRACIÓN II - VARIABLES DE ENTORNO
# ============================================================
# Copiar este archivo como .env en la raíz del proyecto:
#   cp .env.example .env
#
# IMPORTANTE: No subir el archivo .env al repositorio.
# ============================================================

# ------------------------------------------------------------
# VERSIONES DEL ENTORNO DE DESARROLLO (Referencia para el equipo)
# ------------------------------------------------------------
# Node.js        : v24.15.0
# npm            : 11.12.1
# pnpm           : 12.4.2   (recomendado como gestor de paquetes)
# Git            : 2.55.0
# Docker         : 29.8.0
# Docker Compose : 5.5.1
# WSL            : 2.7.14
# NestJS CLI     : 12.0.1
# ------------------------------------------------------------

# ------------------------------------------------------------
# VERSIONES DE DEPENDENCIAS DEL PROYECTO (npm packages)
# ------------------------------------------------------------
# NestJS Core    : 12.0.3
# Prisma ORM     : 8.0.0
# Prisma Client  : 7.10.0
# Vite           : 8.3.0
# React          : 19.3.0
# Tailwind CSS   : 4.3.3
# TypeScript     : 7.0.2
# ------------------------------------------------------------

# ========================
# BASE DE DATOS (PostgreSQL via Docker)
# ========================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=tu_password_segura
DB_NAME=taller_integracion_db
DATABASE_URL=postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ========================
# MS-AUTH (Microservicio de Autenticación)
# ========================
AUTH_PORT=3001
JWT_SECRET=tu_jwt_secret_seguro_aqui
JWT_EXPIRATION=24h

# ========================
# MS-INCIDENCIAS (Microservicio de Incidencias)
# ========================
INCIDENCIAS_PORT=3002

# ========================
# API GATEWAY
# ========================
GATEWAY_PORT=3000

# ========================
# FRONTEND WEB (Vite + React)
# ========================
VITE_API_URL=http://localhost:${GATEWAY_PORT}/api
VITE_APP_NAME=Taller Integración II

# ========================
# CLOUDINARY (Almacenamiento multimedia)
# ========================
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ========================
# NODEMAILER (Envío de correos)
# ========================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_correo@gmail.com
MAIL_PASSWORD=tu_app_password
MAIL_FROM="Taller Integración II <noreply@tallerintegracion.cl>"
