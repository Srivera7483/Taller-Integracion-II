# Variables de entorno para MS Autenticación
# Copiar como .env: cp .env.example .env

# Conexión a PostgreSQL (auth_db en Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/auth_db

# Puerto del microservicio
AUTH_PORT=3001

# JWT secret para firmar tokens
JWT_SECRET=super_secret_key_change_me

# Secreto distinto para firmar refresh tokens (obligatorio en producción)
JWT_REFRESH_SECRET=use_a_different_long_random_secret
