generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EstadoIncidencia {
  Reportada
  Asignada
  Resuelta
}

model Incidencias {
  id_incidencia   String               @id @unique @default(uuid()) @db.Uuid
  id_activo       String               @db.Uuid
  id_reportante   String               @db.Uuid
  titulo          String               @db.VarChar(255)
  descripcion     String               @db.Text
  fecha_creacion  DateTime             @default(now()) @db.Timestamp()

  historial       HistorialIncidencia[]
  ordenes_trabajo OrdenTrabajo[]

  @@map("INCIDENCIAS")
}

model HistorialIncidencia {
  id_historial    String           @id @default(uuid()) @db.Uuid
  id_incidencia   String           @db.Uuid
  estado_anterior EstadoIncidencia
  estado_nuevo    EstadoIncidencia
  usuario_id      String           @db.Uuid
  fecha           DateTime         @default(now()) @db.Timestamp()

  incidencia      Incidencias      @relation(fields: [id_incidencia], references: [id_incidencia], onDelete: Cascade)

  @@index([id_incidencia])
  @@map("HISTORIAL_INCIDENCIA")
}

model OrdenTrabajo {
  id_orden            String       @id @default(uuid()) @db.Uuid
  id_incidencia       String       @db.Uuid
  id_tecnico          String       @db.Uuid 
  diagnostico_tecnico String?      @db.Text 
  fecha_creacion      DateTime     @default(now()) @db.Timestamp()

  incidencia          Incidencias  @relation(fields: [id_incidencia], references: [id_incidencia], onDelete: Cascade)

  @@index([id_incidencia])
  @@index([id_tecnico])
  @@map("ORDENES_TRABAJO")
}