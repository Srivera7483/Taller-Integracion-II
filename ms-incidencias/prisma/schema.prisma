generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EstadoIncidencia {
  Reportada
  Asignada
  Resuelta
}

model Incidencias {
  id_incidencia String           @id @unique @default(uuid())
  id_activo     String
  id_reportante String
  titulo        String           @db.VarChar(255)
  descripcion   String           @db.Text
  estado        EstadoIncidencia @default(Reportada)
  created_at    DateTime         @default(now()) @db.Timestamp()

  historial HistorialIncidencia[]
  evidencias Evidencia[]
}

model HistorialIncidencia {
  id_historial    String           @id @default(uuid()) @db.Uuid
  id_incidencia   String           @db.Uuid
  estado_anterior EstadoIncidencia
  estado_nuevo    EstadoIncidencia
  usuario_id      String           @db.Uuid
  fecha           DateTime         @default(now()) @db.Timestamp()

  incidencia      Incidencias      @relation(fields: [id_incidencia], references: [id_incidencia], onDelete: Cascade)

  @@index([id_incidencia])
  @@map("HISTORIAL_INCIDENCIA")
}

model Evidencia {
  id_evidencia  String      @id @default(uuid())
  incidencia_id String
  descripcion   String      @db.Text
  fecha         DateTime    @default(now()) @db.Timestamp()

  incidencia Incidencias @relation(fields: [incidencia_id], references: [id_incidencia], onDelete: Cascade)

  @@index([incidencia_id])
}
