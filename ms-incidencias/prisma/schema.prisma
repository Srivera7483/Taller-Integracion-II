generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EstadoIncidencia {
  id_estado         Int                @id @default(autoincrement())
  nombre_estado     String             @db.VarChar(100)
  historial_estados HistorialEstados[]

  @@map("ESTADOS_INCIDENCIA")
}

model Incidencias {
  id_incidencia  String   @id @default(uuid()) @db.Uuid
  id_activo      String   @db.Uuid
  id_reportante  String   @db.Uuid
  titulo         String   @db.VarChar(255)
  descripcion    String   @db.Text
  fecha_creacion DateTime @default(now()) @db.Timestamp()

  historial_estados HistorialEstados[]
  ordenes_trabajo   OrdenTrabajo[]
  evidencias        Evidencia[]

  @@map("INCIDENCIAS")
}

model HistorialEstados {
  id_historial      String           @id @default(uuid()) @db.Uuid
  id_incidencia     String           @db.Uuid
  id_estado         Int
  id_usuario_cambio String           @db.Uuid
  fecha_creacion    DateTime         @default(now()) @db.Timestamp()

  incidencia        Incidencias      @relation(fields: [id_incidencia], references: [id_incidencia], onDelete: Cascade)
  estado            EstadoIncidencia @relation(fields: [id_estado], references: [id_estado])

  @@index([id_incidencia])
  @@index([id_estado])
  @@map("HISTORIAL_ESTADOS")
}

model OrdenTrabajo {
  id_orden            String      @id @default(uuid()) @db.Uuid
  id_incidencia       String      @db.Uuid
  id_tecnico          String      @db.Uuid
  diagnostico_tecnico String?     @db.Text
  fecha_creacion      DateTime    @default(now()) @db.Timestamp()

  incidencia          Incidencias @relation(fields: [id_incidencia], references: [id_incidencia], onDelete: Cascade)

  @@index([id_incidencia])
  @@index([id_tecnico])
  @@map("ORDENES_TRABAJO")
}

model TipoEvidencia {
  id_tipo_evidencia Int         @id @default(autoincrement())
  nombre_tipo       String      @db.VarChar(100)
  evidencias        Evidencia[]

  @@map("TIPOS_EVIDENCIA")
}

model Evidencia {
  id_evidencia      String        @id @default(uuid()) @db.Uuid
  id_incidencia     String        @db.Uuid
  id_tipo_evidencia Int
  url_cloudinary    String        @db.VarChar(500)
  fecha_creacion    DateTime      @default(now()) @db.Timestamp()

  incidencia        Incidencias   @relation(fields: [id_incidencia], references: [id_incidencia], onDelete: Cascade)
  tipo_evidencia    TipoEvidencia @relation(fields: [id_tipo_evidencia], references: [id_tipo_evidencia])

  @@index([id_incidencia])
  @@index([id_tipo_evidencia])
  @@map("EVIDENCIAS")
}
