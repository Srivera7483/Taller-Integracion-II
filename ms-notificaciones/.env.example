PORT=3004
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
RABBITMQ_QUEUE_CRITICAS="incidencias_criticas"

# ============================================================
# RABBITMQ - Topología de mensajería (TAL-176)
# ============================================================
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
RABBITMQ_EXCHANGE="uct.activos.events"
RABBITMQ_EXCHANGE_TYPE="topic"
RABBITMQ_QUEUE_NOTIFICACIONES="notificaciones.queue"
RABBITMQ_QUEUE_AUDITORIA="auditoria.queue"
RABBITMQ_DLX="uct.dlx"
RABBITMQ_DLQ="dead-letter.queue"
RABBITMQ_DLQ_ROUTING_KEY="dead-letter"
# TTL de 5 minutos (300.000 ms) para la cola de reintentos / DLQ
RABBITMQ_MESSAGE_TTL="300000"
# Límite máximo de reintentos antes de enviar a DLQ
RABBITMQ_MAX_RETRIES="3"