PORT=3004

# ============================================================
# SMTP - Configuración de Correo Institucional (Nodemailer)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notificaciones@institucion.edu
SMTP_PASS=tu_password_o_app_token
MAIL_FROM="InfraManager Notificaciones <notificaciones@institucion.edu>"
ALLOW_SMTP_FALLBACK=false
MAIL_ALERTAS_CRITICAS=alertas.criticas@institucion.edu
MAIL_ALERTAS_MANTENIMIENTO=mantenimiento.infra@institucion.edu

# ============================================================
# RABBITMQ - Conexión básica y microservicios NestJS
# ============================================================
RABBITMQ_URL="amqp://inframanager:inframanager-local@localhost:5672"
RABBITMQ_QUEUE_CRITICAS="incidencias_criticas"
RABBITMQ_DLQ_EXCHANGE="incidencias_criticas.dlx"
RABBITMQ_DLQ_ROUTING_KEY="incidencias_criticas"

# ============================================================
# RABBITMQ - Topología de mensajería (TAL-176 / TAL-177)
# ============================================================
RABBITMQ_EXCHANGE="uct.activos.events"
RABBITMQ_EXCHANGE_TYPE="topic"
RABBITMQ_QUEUE_NOTIFICACIONES="notificaciones.queue"
RABBITMQ_QUEUE_AUDITORIA="auditoria.queue"
RABBITMQ_DLX="uct.dlx"
RABBITMQ_DLQ="dead-letter.queue"
RABBITMQ_MESSAGE_TTL="300000"
RABBITMQ_MAX_RETRIES="3"
